# Copy to data_pipeline/.env (gitignored) and fill in the password.
# This ONE file is read by Python (db/connection.py), R (fetch_results.R) and Prisma (database/prisma.config.ts).
# URL-encode special characters in the password (e.g. @ -> %40).
DATABASE_URL=postgresql://afl_user:<password>@localhost:5432/afl_analytics
TEST_DATABASE_URL=postgresql://afl_user:<password>@localhost:5432/afl_analytics_test
